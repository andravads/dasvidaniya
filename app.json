{
  "expo": {
    "name": "Homies OS",
    "slug": "ads-assistant",
    "scheme": "homiesos",
    "version": "0.1.0",
    "extra": {
      "eas": {
        "projectId": "64949f00-07a2-4515-a279-64d90ff38443"
      }
    },
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-document-picker",
      "expo-secure-store",
      "expo-sharing",
      "expo-dev-client"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homies.os",
      "infoPlist": {
        "NSCameraUsageDescription": "Photograph a card or authorized document for your workspace.",
        "NSFaceIDUsageDescription": "Unlock your Homies OS session."
      }
    },
    "android": {
      "package": "com.homies.os"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "owner": "andravads"
  }
}
